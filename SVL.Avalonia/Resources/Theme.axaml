<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- 颜色资源定义已移至 App.axaml Application.Resources，由 ThemeService 运行时更新 -->


  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- 托管对话框没有自己的应用级样式树，统一设置窗口底色，避免
       FluentTheme 在 Icon/本地 Mod 等弹窗周围注入浅色背景。 -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>

  <!-- ComboBox 下拉弹出面板背景：直接定位模板内 PopupBorder，绕过 FluentTheme ThemeScope 的 Light 变体资源 -->
  <Style Selector="ComboBox /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>

  <!-- FlyoutPresenter: ComboBox/Menu 等弹出面板背景，使用 DynamicResource 跟随深色模式 -->
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>

  <!-- ContextMenu 位于独立 Popup 视觉树中，显式绑定主题资源，避免深色主题下仍显示系统浅色菜单。 -->
  <Style Selector="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ContextMenu MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ContextMenu MenuItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource CardHighlightBg}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="ContextMenu Separator">
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
  </Style>

  <!-- ContextMenu 的 Presenter 位于独立 Popup 视觉树中，不能只依赖页面样式；
       在应用级样式中覆盖 Fluent 默认浅色面板，保证右键菜单跟随夜间模式。 -->
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="MenuFlyoutPresenter MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="MenuFlyoutPresenter MenuItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource CardHighlightBg}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="MenuFlyoutPresenter MenuItem:disabled">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="MenuFlyoutPresenter Separator">
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
  </Style>

  <!-- ToolTip: 提示框背景/前景，使用 DynamicResource 跟随深色模式 -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- ConfirmDialog 是独立窗口，Fluent 默认 Button 资源不会稳定跟随应用手动
       管理的暗色主题；显式覆盖按钮状态，保证删除版本等确认弹窗可读。 -->
  <Style Selector="Window.confirmDialog Button">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Window.confirmDialog Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource CardHighlightBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Window.confirmDialog Button:pressed">
    <Setter Property="Background" Value="{DynamicResource CategorySelectedBg}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- ComboBoxItem: 下拉项前景色，确保暗黑模式下可读 -->
  <Style Selector="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- 内容控件前景色：确保暗黑模式下文字可读 -->
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="ToggleSwitch">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Expander">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Slider">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="TextBlock.brand">
    <Setter Property="Foreground" Value="{DynamicResource NavTextBrush}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.nav TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource NavTextBrush}" />
  </Style>

  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource NavTextBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="14,5" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.nav:pointerover">
    <!-- 玻璃悬停：轻透光与细微菲涅尔上缘亮光 -->
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="#33FFFFFF" Offset="0.0" />
          <GradientStop Color="#1AFFFFFF" Offset="1.0" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="BorderBrush" Value="#33FFFFFF" />
  </Style>

  <Style Selector="Button.nav.selected">
    <!-- 液态玻璃透镜选中态：上沿纯白折射高光 + 中部半透流动体 + 柔和内发光感 -->
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Color="#66FFFFFF" Offset="0.0" />
          <GradientStop Color="#3DFFFFFF" Offset="0.3" />
          <GradientStop Color="#28FFFFFF" Offset="1.0" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="BorderBrush" Value="#80FFFFFF" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.nav.back">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="32" />
  </Style>

  <Style Selector="Button.iconPickerOption">
    <Setter Property="Background" Value="{DynamicResource ColorBrushTransparent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushTransparent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Button.iconPickerOption:pointerover">
    <Setter Property="Background" Value="{DynamicResource CardHighlightBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardHighlightBorder}" />
  </Style>

  <Style Selector="Button.settingsNav TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.settingsNav.selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.navButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="MinHeight" Value="34" />
  </Style>

  <Style Selector="Button.navButton TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.navButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource CategorySelectedBg}" />
  </Style>

  <Style Selector="Button.navButton Path">
    <Setter Property="Fill" Value="{DynamicResource DefaultTextForeground}" />
  </Style>

  <Style Selector="Button.navButton.selected">
    <Setter Property="Background" Value="{DynamicResource CategorySelectedBg}" />
  </Style>

  <Style Selector="Button.navButton.selected TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.settingsNav">
    <Setter Property="Background" Value="{DynamicResource ColorBrushTransparent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushGray5}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>

  <Style Selector="Button.settingsNav:pointerover">
    <Setter Property="Background" Value="{DynamicResource ColorBrushGray5}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushGray4}" />
  </Style>

  <Style Selector="Button.settingsNav:pressed">
    <Setter Property="Background" Value="{DynamicResource CategorySelectedBg}" />
  </Style>

  <Style Selector="Button.settingsNav.selected">
    <Setter Property="Background" Value="{DynamicResource CategorySelectedBg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.winCtrl">
    <!-- 占满标题栏单元格，避免 Fluent Button 默认最小高度让三个按钮
         以不同的内容边界参与布局。图标本身固定在统一的 24×24 画布中心。 -->
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="48" />
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.winCtrl:pointerover">
    <Setter Property="Opacity" Value="0.92" />
  </Style>

  <Style Selector="Button.winCtrl.min:pointerover">
    <Setter Property="Background" Value="#3381C784" />
  </Style>

  <Style Selector="Button.winCtrl.max:pointerover">
    <Setter Property="Background" Value="#33FFCA28" />
  </Style>

  <Style Selector="Button.winCtrl.close:pointerover">
    <Setter Property="Background" Value="#44EF5350" />
  </Style>

  <Style Selector="TextBlock.platformTag">
    <Setter Property="Foreground" Value="{DynamicResource ColorBrush5}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="BoxShadow" Value="0 4 16 0 #0D000000" />
  </Style>

  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector="TextBlock.sectionValue">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.pill">
    <Setter Property="Background" Value="{DynamicResource PillBg}" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <Style Selector="TextBlock.heroTitle">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="Border.hintCard">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="BoxShadow" Value="0 2 8 0 #0B000000" />
    <Setter Property="Transitions">
      <Transitions>
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
        <BrushTransition Property="Background" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.hintCard:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BoxShadow" Value="0 4 14 0 #1A000000" />
    <Setter Property="Background" Value="{DynamicResource CardHighlightBg}" />
  </Style>

  <!-- 英雄横幅与特性卡片 -->
  <Style Selector="Border.heroCard">
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardHighlightBorder}" />
    <Setter Property="BoxShadow" Value="0 6 20 0 #18000000" />
    <Setter Property="Padding" Value="20" />
  </Style>

  <!-- 液态玻璃拟态卡片 (Liquid Glass Card) -->
  <Style Selector="Border.liquidGlass">
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#66FFFFFF" />
    <Setter Property="BoxShadow" Value="0 4 16 0 #1A000000, 0 1 2 0 #33FFFFFF" />
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#55FFFFFF" Offset="0.0" />
          <GradientStop Color="#22FFFFFF" Offset="1.0" />
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.liquidGlass:pointerover">
    <Setter Property="BorderBrush" Value="#A0FFFFFF" />
    <Setter Property="BoxShadow" Value="0 6 22 0 #28000000, 0 1 4 0 #66FFFFFF" />
  </Style>

  <!-- 仪表盘统计小方卡 -->
  <Style Selector="Border.statCard">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="BoxShadow" Value="0 2 6 0 #08000000" />
    <Setter Property="Transitions">
      <Transitions>
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.16" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.statCard:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BoxShadow" Value="0 4 12 0 #15000000" />
  </Style>

  <Style Selector="TextBlock.hintTitle">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button:pointerover:enabled">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Background" Value="{DynamicResource ColorBrushGray6}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushGray4}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <Style Selector="Button.flatTask">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.flatTask:pointerover">
    <Setter Property="Opacity" Value="0.9" />
  </Style>

  <Style Selector="Button.flatTask.activeTask">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush3}" />
  </Style>

  <Style Selector="Button.flatTask.historyTask">
    <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>

  <Style Selector="Button.taskAction">
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Margin" Value="0,0,4,4" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Height" Value="24" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.downloadCategory">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="#00FFFFFF" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="52" />
  </Style>

  <Style Selector="Button.downloadCategory:pointerover">
    <Setter Property="Background" Value="{DynamicResource CategorySelectedBg}" />
    <Setter Property="BorderBrush" Value="#66D4C4A8" />
  </Style>

  <Style Selector="Button.downloadCategory:pressed">
    <Setter Property="Background" Value="{DynamicResource ColorBrushGray4}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushGray4}" />
  </Style>

  <Style Selector="Button.launchPrimary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.launchPrimary:pointerover">
    <Setter Property="Background" Value="{DynamicResource ColorBrush2}" />
    <Setter Property="Opacity" Value="0.95" />
  </Style>

  <Style Selector="Button.launchPrimary:pressed">
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style Selector="Button.launchSecondary">
    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.launchSecondary:pointerover">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- 主操作语义类 accent：卡片/表单内需要强调的主操作按钮。
       Business Rule: 与 launchPrimary 共用强调色语义，但保留默认紧凑圆角，
       适配行内与表单场景；缺省时退化为普通次要按钮，会导致主次层级丢失。 -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.accent TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
  </Style>

  <Style Selector="Button.accent:pointerover">
    <Setter Property="Background" Value="{DynamicResource ColorBrush2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush2}" />
    <Setter Property="Opacity" Value="0.95" />
  </Style>

  <Style Selector="Button.accent:pressed">
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <!-- 必须置于 Button:disabled 之后：二者特异性相同，靠源顺序保证禁用态不被强调色覆盖。 -->
  <Style Selector="Button.accent:disabled">
    <Setter Property="Background" Value="{DynamicResource ColorBrushGray6}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushGray4}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!-- primaryAction 别名（与 accent 保持一致，确保强调色按钮内文字使用 TextOnAccentBrush 高对比呈现） -->
  <Style Selector="Button.primaryAction">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.primaryAction TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
  </Style>

  <Style Selector="Button.primaryAction:pointerover">
    <Setter Property="Background" Value="{DynamicResource ColorBrush2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush2}" />
    <Setter Property="Opacity" Value="0.95" />
  </Style>

  <Style Selector="Button.primaryAction:pressed">
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <Style Selector="Button.primaryAction:disabled">
    <Setter Property="Background" Value="{DynamicResource ColorBrushGray6}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushGray4}" />
    <Setter Property="Opacity" Value="0.6" />
  </Style>
</Styles>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SVL.Avalonia.ViewModels"
             xmlns:models="using:SVL.Avalonia.Models"
             x:Class="SVL.Avalonia.Views.TaskStatusPageView"
             x:DataType="vm:TaskStatusPageViewModel">
  <Grid ColumnDefinitions="280,*">
    <!-- 左栏：多任务列表 -->
    <Border Grid.Column="0" Classes="panel">
      <Grid RowDefinitions="Auto,*">
        <!-- 列表标题 + 清空已完成 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Text="{Binding TasksListTitleText}" Classes="sectionTitle" />
            <TextBlock FontSize="12" Opacity="0.7">
              <Run Text="{Binding ActivePrefixText}" />
              <Run Text="{Binding ActiveTasksCount}" />
              <Run Text="{Binding FinishedPrefixText}" />
              <Run Text="{Binding FinishedTasksCount}" />
            </TextBlock>
          </StackPanel>
          <Button Grid.Column="1" Content="{Binding ClearCompletedText}"
                  Command="{Binding ClearCompletedCommand}"
                  IsEnabled="{Binding CanClearCompleted}"
                  Classes="settingsNav"
                  MinWidth="92" />
        </Grid>

        <!-- 空状态 -->
        <Border Grid.Row="1" Classes="hintCard" IsVisible="{Binding IsEmptyState}">
          <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/Inbox.png" Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" Opacity="0.4" />
            <TextBlock Text="{Binding EmptyTitleText}" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding EmptyDescText}" Opacity="0.72" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="240" />
            <Button Content="{Binding GoDownloadText}" Command="{Binding GoToDownloadCommand}" HorizontalAlignment="Center" MinWidth="120" Height="34" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <!-- 任务列表 -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsEmptyState}">
          <ItemsControl ItemsSource="{Binding Tasks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="models:DownloadTaskItem">
                <Button Classes="flatTask"
                        Command="{Binding DataContext.SelectTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="8" Margin="0,0,0,6">
                  <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="2,0">
                    <!-- 任务名 + 状态文本 -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis" MaxLines="1" />
                      <TextBlock Grid.Column="1" Text="{Binding DisplayStatusText}" FontSize="11" Opacity="0.7"
                                 Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <!-- 进度条 + 多线程分块进度 -->
                    <StackPanel Grid.Row="1" Margin="0,4,0,0" Spacing="2">
                      <!-- 多线程时用分块进度条作为主显示；单线程时才显示整条总进度 -->
                      <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="6" IsVisible="{Binding !HasSegmentProgress}" />
                      <ItemsControl ItemsSource="{Binding SegmentItems}" IsVisible="{Binding HasSegmentProgress}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="models:DownloadSegmentItem">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="6" Margin="1,0" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <!-- 速度/ETA/子进度 -->
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,2,0,0"
                          IsVisible="{Binding HasSpeedInfo}">
                      <TextBlock Grid.Column="0" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding SpeedText}" />
                        <Run Text=" · " />
                        <Run Text="{Binding DownloadedSizeText}" />
                        <Run Text=" / " />
                        <Run Text="{Binding TotalSizeText}" />
                      </TextBlock>
                      <TextBlock Grid.Column="1" Text="{Binding EtaText}" FontSize="11" Opacity="0.65" Margin="8,0,0,0" />
                    </Grid>
                    <TextBlock Grid.Row="3" FontSize="11" Opacity="0.65" Text="{Binding SubProgressText}"
                               IsVisible="{Binding HasSubProgress}" Margin="0,2,0,0" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- 右栏：选中任务详情 + 操作栏 + 日志 -->
    <Border Grid.Column="1" Classes="panel" Margin="12,0,0,0">
      <ScrollViewer IsVisible="{Binding ShowMainStateContent}">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding DetailTitleText}" Classes="heroTitle" />

          <!-- 空选中提示与全景概览卡片（充实未选中时的右侧大片空白） -->
          <StackPanel Spacing="12" IsVisible="{Binding !HasSelectedTask}">
            <Border Classes="hintCard" Padding="20">
              <StackPanel Spacing="10" HorizontalAlignment="Center">
                <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/Inbox.png" Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center" Opacity="0.5" />
                <TextBlock Text="{Binding DetailEmptyTitleText}" Classes="hintTitle" FontSize="16" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding DetailEmptyDescText}"
                           Opacity="0.75" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440" />
              </StackPanel>
            </Border>

            <!-- 快捷提示与下载指引 -->
            <Grid ColumnDefinitions="*,*">
              <Border Grid.Column="0" Classes="statCard" Margin="0,0,6,0">
                <StackPanel Spacing="6">
                  <TextBlock Text="下载队列提示" FontWeight="SemiBold" FontSize="13" />
                  <TextBlock Text="• 支持多任务并发与大文件多线程分块下载&#x0a;• 下载中的任务支持随时暂停、取消或重试&#x0a;• 整合包与 Mod 会在下载后自动执行安全解压"
                             FontSize="12" Opacity="0.75" TextWrapping="Wrap" LineHeight="18" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Classes="statCard" Margin="6,0,0,0">
                <StackPanel Spacing="6">
                  <TextBlock Text="快捷直达" FontWeight="SemiBold" FontSize="13" />
                  <TextBlock Text="想要寻找新的 Mod 或整合包？" FontSize="12" Opacity="0.75" Margin="0,0,0,4" />
                  <Button Content="{Binding GoDownloadText}" Command="{Binding GoToDownloadCommand}" Classes="launchSecondary" Height="32" Padding="14,0" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>

          <!-- 选中任务详情 -->
          <Border Classes="hintCard" IsVisible="{Binding HasSelectedTask}">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding CurrentTaskName}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
              <TextBlock Text="{Binding CurrentTaskStatus}" Opacity="0.8" TextWrapping="Wrap" />
              <StackPanel Spacing="2" IsVisible="{Binding SelectedTaskHasTargetGamePath}">
                <TextBlock Text="{Binding DetailTargetPathText}" FontSize="11" Opacity="0.65" />
                <TextBlock Text="{Binding SelectedTaskTargetGamePath}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Spacing="2" IsVisible="{Binding SelectedTaskHasInstalledPath}">
                <TextBlock Text="{Binding DetailInstalledPathText}" FontSize="11" Opacity="0.65" />
                <TextBlock Text="{Binding SelectedTaskInstalledPath}" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 失败详情 -->
          <Border Classes="hintCard" IsVisible="{Binding IsFailedState}">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding FailedTitleText}" Classes="hintTitle" />
              <TextBlock Text="{Binding FailureSummary}" TextWrapping="Wrap" FontWeight="SemiBold" />
            </StackPanel>
          </Border>

          <!-- 运行中进度（分层：总进度+子进度+速度+ETA） -->
          <Border Classes="hintCard" IsVisible="{Binding IsRunningState}">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding ProgressTitleText}" Classes="hintTitle" />
              <!-- 多线程时用分块进度条作为主显示；单线程时才显示整条总进度 -->
              <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="10" IsVisible="{Binding !SelectedTask.HasSegmentProgress}" />
              <!-- 多线程分片进度（每线程一条，分块加载） -->
              <ItemsControl ItemsSource="{Binding SelectedTask.SegmentItems}" IsVisible="{Binding SelectedTask.HasSegmentProgress}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="models:DownloadSegmentItem">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="10" Margin="1,0" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" FontSize="12" Opacity="0.75">
                  <Run Text="{Binding ProgressLabelText}" />
                  <Run Text="{Binding ProgressPercent, StringFormat={}{0:F1}%}" />
                </TextBlock>
                <TextBlock Grid.Column="1" FontSize="12" Opacity="0.75" Text="{Binding SelectedTaskSpeedText}"
                           IsVisible="{Binding SelectedTaskHasSpeedInfo}" />
              </Grid>
              <!-- 分层进度：速度/大小/ETA -->
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding SelectedTaskHasSpeedInfo}" Margin="0,2,0,0">
                <TextBlock Grid.Column="0" FontSize="12" Opacity="0.7">
                  <Run Text="{Binding SelectedTaskDownloadedSizeText}" />
                  <Run Text=" / " />
                  <Run Text="{Binding SelectedTaskTotalSizeText}" />
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding SelectedTaskEtaText}" FontSize="12" Opacity="0.7" Margin="8,0,0,0" />
              </Grid>
              <!-- 子进度（Collection/整合包） -->
              <StackPanel Spacing="4" IsVisible="{Binding SelectedTaskHasSubProgress}" Margin="0,4,0,0">
                <TextBlock Text="{Binding SelectedTaskSubProgressText}" FontSize="12" Opacity="0.7" />
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding SelectedTaskSubProgress}" Height="4"
                             IsVisible="{Binding SelectedTaskHasSubProgress}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- 完成/取消态提示 -->
          <Border Classes="hintCard" IsVisible="{Binding IsCompletedState}">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding CompletedTitleText}" Classes="hintTitle" />
              <TextBlock Text="{Binding CompletedDescText}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="hintCard" IsVisible="{Binding IsCancelledState}">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding CancelledTitleText}" Classes="hintTitle" />
              <TextBlock Text="{Binding CancelledDescText}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- 操作栏：完整操作按钮，按状态启用 -->
          <Border Classes="hintCard" IsVisible="{Binding HasSelectedTask}">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding ActionTitleText}" Classes="hintTitle" />
              <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="{Binding ActionCancelText}" Command="{Binding CancelTaskCommand}"
                        CommandParameter="{Binding SelectedTask}"
                        IsEnabled="{Binding SelectedTaskCanCancel}"
                        MinWidth="92" Margin="0,0,8,8" />
                <Button Content="{Binding ActionRetryText}" Command="{Binding RetryTaskCommand}"
                        CommandParameter="{Binding SelectedTask}"
                        IsEnabled="{Binding SelectedTaskCanRetry}"
                        MinWidth="92" Margin="0,0,8,8" />
                <Button Content="{Binding ActionRemoveText}" Command="{Binding RemoveTaskCommand}"
                        CommandParameter="{Binding SelectedTask}"
                        MinWidth="92" Margin="0,0,8,8" />
                <Button Content="{Binding ActionOpenDirText}" Command="{Binding OpenDirectoryCommand}"
                        CommandParameter="{Binding SelectedTask}"
                        IsEnabled="{Binding SelectedTaskHasInstalledDirectory}"
                        MinWidth="92" Margin="0,0,8,8" />
                <Button Content="{Binding ActionOpenReportText}" Command="{Binding OpenReportCommand}"
                        CommandParameter="{Binding SelectedTask}"
                        IsVisible="{Binding SelectedTaskHasReportPath}"
                        MinWidth="92" Margin="0,0,8,8" />
                <Button Content="{Binding ActionOpenRetryReportText}" Command="{Binding OpenRetryReportForTaskCommand}"
                        CommandParameter="{Binding SelectedTask}"
                        IsVisible="{Binding SelectedTaskHasRetryReportPath}"
                        MinWidth="108" Margin="0,0,8,8" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <!-- 建议操作 -->
          <Border Classes="hintCard">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding AdviceTitle}" Classes="hintTitle" />
              <ItemsControl ItemsSource="{Binding SuggestedActions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" Margin="0,0,0,6" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- 冲突预览 -->
          <Border Classes="hintCard" IsVisible="{Binding HasConflictPreview}">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding ConflictPreviewTitleText}" Classes="hintTitle" />
              <ScrollViewer Height="120">
                <ItemsControl ItemsSource="{Binding ConflictPreviewItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>

          <!-- 实时日志面板 -->
          <Border Classes="hintCard">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding LogTitleText}" Classes="hintTitle" />
                <Button Grid.Column="1" Content="{Binding LogCopyText}" Command="{Binding CopyLogsCommand}" MinWidth="60" Margin="0,0,6,0" />
                <Button Grid.Column="2" Content="{Binding LogClearText}" Command="{Binding ClearLogsCommand}" MinWidth="60" />
              </Grid>
              <ScrollViewer Height="160">
                <ItemsControl ItemsSource="{Binding TaskLogs}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" FontSize="11" FontFamily="Cascadia Mono,Consolas,Courier New"
                                 Opacity="0.8" TextWrapping="Wrap" Margin="0,0,0,2" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SVL.Avalonia.ViewModels"
             xmlns:converters="using:SVL.Avalonia.Converters"
             xmlns:angif="using:AnimatedImage.Avalonia"
             x:Class="SVL.Avalonia.Views.VersionSettingsPageView"
             x:Name="Root"
             x:DataType="vm:VersionSettingsPageViewModel">
  <UserControl.Styles>
    <Style Selector="Button.navButton">
      <Setter Property="Height" Value="42" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Margin" Value="0,2,0,2" />
    </Style>

    <Style Selector="Button.navButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>

    <Style Selector="Button.navButton.selected">
      <Setter Property="Background" Value="{DynamicResource CategorySelectedBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Button.segmentMain">
      <Setter Property="Height" Value="38" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.segmentMain.selected">
      <Setter Property="Background" Value="{DynamicResource CategorySelectedBg}" />
    </Style>

    <Style Selector="Button.segmentSub">
      <Setter Property="Height" Value="32" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.segmentSub.selected">
      <Setter Property="Background" Value="{DynamicResource CategorySelectedBg}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.toolbarAction">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.paginationButton">
      <Setter Property="Height" Value="30" />
      <Setter Property="MinWidth" Value="38" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.modRow">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.modRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardHighlightBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>

    <Style Selector="StackPanel.rowMeta">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Delay="0:0:0.05" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.modRow:pointerover StackPanel.rowMeta">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="StackPanel.rowHoverActions">
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Delay="0:0:0.05" Duration="0:0:0.16" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="Border.modRow:pointerover StackPanel.rowHoverActions">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>

    <Style Selector="Button.rowAction">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <Style Selector="Button.rowAction:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardHighlightBg}" />
    </Style>

    <Style Selector="Button.rowQuickAction">
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource CardHighlightBg}" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="Button.rowQuickAction:pointerover">
      <Setter Property="Background" Value="{DynamicResource CardHighlightBg}" />
    </Style>

    <Style Selector="ListBox.modList > ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource CategorySelectedBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="280,1,*">
    <Border Grid.Column="0" Classes="panel" Padding="12">
      <Grid RowDefinitions="Auto,*,Auto,Auto">
        <Border Grid.Row="0" Classes="hintCard" Padding="14,10" Margin="0,0,0,10">
          <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
        </Border>

        <Border Grid.Row="1" Classes="hintCard" Padding="8" Margin="0,0,0,10">
          <StackPanel Spacing="4">
            <Button Classes="navButton"
                    Classes.selected="{Binding IsModManageSection}"
                    Command="{Binding SwitchToModManageSectionCommand}">
              <Grid ColumnDefinitions="Auto,*">
                <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/Package.png" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding ModManageNavText}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="navButton"
                    Classes.selected="{Binding IsModpackSection}"
                    Command="{Binding SwitchToModpackSectionCommand}">
              <Grid ColumnDefinitions="Auto,*">
                <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/Package.png" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding ModpackNavText}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="navButton"
                    Classes.selected="{Binding IsAutoInstallSection}"
                    Command="{Binding SwitchToAutoInstallSectionCommand}">
              <Grid ColumnDefinitions="Auto,*">
                <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/Download.png" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding AutoInstallNavText}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="navButton"
                    Classes.selected="{Binding IsOverviewSection}"
                    Command="{Binding SwitchToGeneralSectionCommand}">
              <Grid ColumnDefinitions="Auto,*">
                <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/BarChart.png" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding OverviewNavText}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Button Classes="navButton"
                    Classes.selected="{Binding IsSettingsSection}"
                    Command="{Binding SwitchToInstanceSettingsSectionCommand}">
              <Grid ColumnDefinitions="Auto,*">
                <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/Settings.png" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding InstanceSettingsNavText}" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Classes="hintCard" Padding="12,10" Margin="0,0,0,10">
          <Grid ColumnDefinitions="Auto,*">
            <Border Width="36"
                    Height="36"
                    CornerRadius="6"
                    Background="Transparent"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1"
                    Margin="0,0,10,0">
              <Image Source="{Binding InstanceIconSource, Converter={StaticResource AssetImageConverter}}"
                   angif:ImageBehavior.AnimatedSource="{Binding InstanceIconSource, Converter={StaticResource AssetImageConverter}, ConverterParameter=animate}"
                     Stretch="Uniform"
                     Margin="4" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding InstanceDisplayName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding StardewVersionDisplay}" FontSize="11" Opacity="0.72" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="3" Classes="hintCard" Padding="12,10" Margin="0,0,0,0">
          <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
        </Border>
      </Grid>
    </Border>

    <Border Grid.Column="1" Background="{DynamicResource PanelBorderBrush}" Margin="0,16" />

    <Grid Grid.Column="2" Margin="12,0,0,0" RowDefinitions="*,Auto">
      <ScrollViewer Grid.Row="0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,0,10,0">
        <StackPanel Spacing="12">
          <Border Classes="hintCard" IsVisible="{Binding IsOverviewSection}" Padding="14,12">
            <StackPanel Spacing="10">
              <Border Classes="hintCard" Padding="16,12">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Width="54"
                          Height="54"
                          CornerRadius="7"
                          Background="Transparent"
                          BorderBrush="{DynamicResource PanelBorderBrush}"
                          BorderThickness="1"
                          VerticalAlignment="Top"
                          Margin="0,0,14,0">
                    <Image Source="{Binding InstanceIconSource, Converter={StaticResource AssetImageConverter}}"
                   angif:ImageBehavior.AnimatedSource="{Binding InstanceIconSource, Converter={StaticResource AssetImageConverter}, ConverterParameter=animate}"
                           Width="36"
                           Height="36"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{Binding OverviewVersionCardTitleText}" Classes="sectionTitle" />
                    <TextBlock Text="{Binding InstanceDisplayName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/Gamepad.png" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Opacity="0.78" />
                      <TextBlock Text="{Binding VanillaLabelText}" FontSize="13" Opacity="0.78" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding InstanceVersionText}" FontSize="13" Opacity="0.78" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowSmapiVersion}">
                      <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/Wrench.png" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Opacity="0.78" />
                      <TextBlock Text="SMAPI: " FontSize="13" Opacity="0.78" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding SmapiVersionText}" FontSize="13" Opacity="0.78" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowNoSmapiHint}">
                      <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/Lightbulb.png" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Opacity="0.68" />
                      <TextBlock Text="{Binding NoSmapiHintText}" FontSize="12" Opacity="0.68" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Classes="hintCard" Padding="16,12">
                <StackPanel Spacing="10">
                  <TextBlock Text="{Binding OverviewPersonalizationCardTitleText}" Classes="sectionTitle" />
                  <Grid ColumnDefinitions="120,*">
                    <TextBlock Text="{Binding IconLabelText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <Button Grid.Column="1"
                            Content="{Binding ChangeIconButtonText}"
                            Command="{Binding ChangeIconCommand}"
                            HorizontalAlignment="Left"
                          Height="38"
                          Padding="12,0"
                          VerticalContentAlignment="Center"
                          MinWidth="120" />
                  </Grid>
                  <TextBlock Text="{Binding InstanceNameLabelText}" FontWeight="SemiBold" />
                  <TextBox Text="{Binding InstanceName}" />
                  <TextBlock Text="{Binding InstanceDescriptionLabelText}" FontWeight="SemiBold" />
                  <TextBox Text="{Binding InstanceDescription}" Height="78" AcceptsReturn="True" TextWrapping="Wrap" />
                  <CheckBox Content="{Binding FavoriteInstanceLabelText}" IsChecked="{Binding IsFavoriteInstance}" />
                  <Button Content="{Binding SavePersonalizationButtonText}"
                          Command="{Binding SaveInstanceSettingsCommand}"
                          HorizontalAlignment="Left" />
                </StackPanel>
              </Border>

              <Border Classes="hintCard" Padding="16,12">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding OverviewShortcutsCardTitleText}" Classes="sectionTitle" />
                  <Button Content="{Binding OpenInstanceFolderButtonText}"
                          Command="{Binding OpenFolderCommand}"
                          CommandParameter="{Binding CurrentInstanceFolderPath}"
                          Height="40"
                          HorizontalAlignment="Stretch" />
                  <Button Content="{Binding OpenSaveFolderButtonText}"
                          Command="{Binding OpenFolderCommand}"
                          CommandParameter="{Binding SaveFolderPath}"
                          Height="40"
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding HasSaveFolder}" />
                  <Button Content="{Binding OpenModsFolderShortcutButtonText}"
                          Command="{Binding OpenFolderCommand}"
                          CommandParameter="{Binding ModsFolderPath}"
                          Height="40"
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding HasModsFolder}"
                          IsEnabled="{Binding CanManageMods}" />
                </StackPanel>
              </Border>

              <Border Classes="hintCard" Padding="16,12">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Mod 状态概览" Classes="sectionTitle" />
                    <TextBlock Text="{Binding ModsSummary}" FontSize="13" Opacity="0.85" />
                    <TextBlock Text="{Binding ModsFolderPath}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Content="{Binding ModManageNavText}"
                          Command="{Binding SwitchToModManageSectionCommand}"
                          Classes="toolbarAction"
                          VerticalAlignment="Center"
                          Margin="12,0,0,0" />
                </Grid>
              </Border>

              <Border Classes="hintCard" Padding="16,12">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding OverviewAdvancedCardTitleText}" Classes="sectionTitle" />
                  <Border Background="{DynamicResource WarningBg}"
                          BorderBrush="{DynamicResource WarningBorder}"
                          BorderThickness="1"
                          CornerRadius="6"
                          Padding="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/AlertTriangle.png" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding AdvancedWarningText}"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 TextWrapping="Wrap"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>

                  <Button Content="{Binding DeleteCurrentVersionButtonText}"
                          Command="{Binding DeleteCurrentVersionCommand}"
                          Height="42"
                          HorizontalAlignment="Stretch"
                          IsEnabled="{Binding CanDeleteCurrentVersion}" />
                  <TextBlock Text="{Binding DeleteCurrentVersionHintText}"
                             FontSize="12"
                             Opacity="0.72"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border Classes="hintCard" IsVisible="{Binding IsAutoInstallSection}" Padding="14,12">
            <StackPanel Spacing="10">
              <Border Classes="hintCard" Padding="16,12">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Width="54"
                          Height="54"
                          CornerRadius="7"
                          Background="Transparent"
                          BorderBrush="{DynamicResource PanelBorderBrush}"
                          BorderThickness="1"
                          VerticalAlignment="Top"
                          Margin="0,0,14,0">
                    <Image Source="{Binding InstanceIconSource, Converter={StaticResource AssetImageConverter}}"
                   angif:ImageBehavior.AnimatedSource="{Binding InstanceIconSource, Converter={StaticResource AssetImageConverter}, ConverterParameter=animate}"
                           Width="36"
                           Height="36"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{Binding GeneralSectionButtonText}" Classes="sectionTitle" />
                    <TextBlock Text="{Binding InstanceDisplayName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/Gamepad.png" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Opacity="0.78" />
                      <TextBlock Text="{Binding VanillaLabelText}" FontSize="13" Opacity="0.78" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding InstanceVersionText}" FontSize="13" Opacity="0.78" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ShowSmapiVersion}">
                      <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/Wrench.png" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Opacity="0.78" />
                      <TextBlock Text="SMAPI: " FontSize="13" Opacity="0.78" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding SmapiVersionText}" FontSize="13" Opacity="0.78" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Classes="hintCard" Padding="16,12">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding AutoInstallInfoTitleText}" Classes="sectionTitle" />
                  <Button Content="{Binding ChangeSmapiButtonText}"
                          Command="{Binding ChangeSmapiVersionCommand}"
                          IsEnabled="{Binding CanChangeSmapiVersion}"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                          Height="42" />
                  <TextBlock Text="{Binding SmapiGuideText}"
                             FontSize="12"
                             Opacity="0.75"
                             TextWrapping="Wrap"
                             IsVisible="{Binding CanChangeSmapiVersion}" />

                  <!-- SMAPI 安装进度 -->
                  <Border Background="{DynamicResource CardBrush}"
                          BorderBrush="{DynamicResource BorderBrush}"
                          BorderThickness="1"
                          CornerRadius="6"
                          Padding="12,10"
                          IsVisible="{Binding IsInstallingSmapi}">
                    <StackPanel Spacing="6">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/RefreshCw.png" Width="20" Height="20"
                              Stretch="Uniform"
                              VerticalAlignment="Center" />
                        <TextBlock Text="{Binding InstallingSmapiText}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Text="{Binding SmapiInstallProgressText}"
                                 FontSize="12"
                                 Opacity="0.7"
                                 Margin="24,0,0,0" />
                      <ProgressBar IsIndeterminate="True" Height="4" Margin="24,0,0,0" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>

              <Border Background="{DynamicResource WarningBg}"
                      BorderBrush="{DynamicResource WarningBorder}"
                      BorderThickness="1"
                      CornerRadius="6"
                      Padding="12"
                      IsVisible="{Binding ShowSwitchToSmapiHint}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/Wrench.png" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SwitchToSmapiTipText}"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1"
                          Content="{Binding SwitchToSmapiButtonText}"
                          Command="{Binding SwitchToSmapiVersionCommand}"
                          Width="130"
                      Height="32"
                      Margin="8,0,0,0" />
                </Grid>
              </Border>

              <!-- 卸载 SMAPI 操作区（SMAPI 管理生命周期闭环） -->
              <Border Classes="hintCard" Padding="16,12" IsVisible="{Binding CanUninstallBaseSmapi}">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding UninstallBaseSmapiButtonText}" Classes="sectionTitle" />
                  <TextBlock Text="卸载当前版本的 SMAPI，恢复为纯净原版星露谷运行环境。"
                             FontSize="12"
                             Opacity="0.75"
                             TextWrapping="Wrap" />
                  <Button Content="{Binding UninstallBaseSmapiButtonText}"
                          Command="{Binding UninstallBaseSmapiCommand}"
                          Height="40"
                          HorizontalAlignment="Stretch" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <StackPanel Spacing="10" IsVisible="{Binding IsModManageSection}">
            <Border Background="{DynamicResource WarningBg}"
                    BorderBrush="{DynamicResource WarningBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    IsVisible="{Binding ShowBaseModeModWarning}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/AlertTriangle.png" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="{Binding BaseModeWarningText}"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Background="{DynamicResource WarningBg}"
                    BorderBrush="{DynamicResource WarningBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    IsVisible="{Binding ShowSwitchToSmapiHint}">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                  <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/Wrench.png" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding SwitchToSmapiTipText}"
                             FontSize="13"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             VerticalAlignment="Center"
                             TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="{Binding SwitchToSmapiButtonText}"
                        Command="{Binding SwitchToSmapiVersionCommand}"
                        Width="130"
                        Height="32"
                        Margin="8,0,0,0" />
              </Grid>
            </Border>

            <StackPanel Spacing="10" IsVisible="{Binding CanManageMods}">

              <Border Classes="hintCard" Padding="14,12">
                <StackPanel Spacing="10">
                  <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardHighlightBg}">
                    <Grid ColumnDefinitions="*,1,*">
                      <Button Grid.Column="0"
                              Classes="segmentMain"
                              Classes.selected="{Binding IsModsTab}"
                              Command="{Binding SwitchModsTabCommand}"
                              Content="{Binding ModsTabText}" />
                      <Border Grid.Column="1" Background="{DynamicResource PanelBorderBrush}" />
                      <Button Grid.Column="2"
                              Classes="segmentMain"
                              Classes.selected="{Binding IsBackupTab}"
                              Command="{Binding SwitchBackupTabCommand}"
                              Content="{Binding BackupTabText}" />
                    </Grid>
                  </Border>

                  <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" IsVisible="{Binding IsModsTab}">
                    <Grid ColumnDefinitions="*,1,*,1,*,1,*">
                      <Button Grid.Column="0" Classes="segmentSub" Classes.selected="{Binding IsAllFilter}" Content="{Binding AllFilterText}" Command="{Binding SetAllFilterCommand}" />
                      <Border Grid.Column="1" Background="{DynamicResource PanelBorderBrush}" />
                      <Button Grid.Column="2" Classes="segmentSub" Classes.selected="{Binding IsEnabledFilter}" Content="{Binding EnabledFilterText}" Command="{Binding SetEnabledFilterCommand}" />
                      <Border Grid.Column="3" Background="{DynamicResource PanelBorderBrush}" />
                      <Button Grid.Column="4" Classes="segmentSub" Classes.selected="{Binding IsDisabledFilter}" Content="{Binding DisabledFilterText}" Command="{Binding SetDisabledFilterCommand}" />
                      <Border Grid.Column="5" Background="{DynamicResource PanelBorderBrush}" />
                      <Button Grid.Column="6" Classes="segmentSub" Classes.selected="{Binding IsUpdatableFilter}" Content="{Binding UpdatableFilterText}" Command="{Binding SetUpdatableFilterCommand}" />
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>

              <!-- Mods/备份分栏下方的操作工具栏。工具栏与当前分栏保持同一视觉层级，
                   避免打开文件夹、刷新等操作被 Tag 筛选区域隔开。 -->
              <Border Classes="hintCard" Padding="14,12">
                <StackPanel>
                  <WrapPanel IsVisible="{Binding IsModsTab}">
                    <Button Classes="toolbarAction" Content="{Binding ToolbarOpenFolderText}" Command="{Binding OpenCurrentInstanceModsFolderCommand}" />
                    <Button Classes="toolbarAction" Content="{Binding CheckUpdatesText}" Command="{Binding CheckAllModsUpdateCommand}" IsEnabled="{Binding IsCheckingModUpdates, Converter={x:Static BoolConverters.Not}}" />
                    <Button Classes="toolbarAction" Content="{Binding CheckConflictsText}" Command="{Binding DetectModConflictsCommand}" IsEnabled="{Binding CanDetectModConflicts}" />
                    <Button Classes="toolbarAction" Content="{Binding CheckLocalizationText}" Command="{Binding CheckAllModsLocalizationCommand}" IsEnabled="{Binding IsCheckingLocalization, Converter={x:Static BoolConverters.Not}}" />
                    <Button Classes="toolbarAction" Content="{Binding RefreshLocalizationText}" Command="{Binding RefreshSelectedLocalizationCommand}" IsEnabled="{Binding IsCheckingLocalization, Converter={x:Static BoolConverters.Not}}" />
                    <Button Classes="toolbarAction" Content="{Binding SelectAllText}" Command="{Binding ToggleAllSelectionCommand}" />
                    <Button Classes="toolbarAction" Content="{Binding ReloadModsButtonText}" Command="{Binding ReloadModsCommand}" IsEnabled="{Binding IsLoadingMods, Converter={x:Static BoolConverters.Not}}" />
                    <Button Classes="toolbarAction" Width="34" Padding="0" Content="+" ToolTip.Tip="{Binding InstallTipText, RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding InstallModFromLocalCommand}" />
                  </WrapPanel>

                  <WrapPanel IsVisible="{Binding IsBackupTab}">
                    <Button Classes="toolbarAction" Content="{Binding ToolbarOpenFolderText}" Command="{Binding OpenBackupFolderCommand}" />
                    <Button Classes="toolbarAction" Content="{Binding SelectAllText}" Command="{Binding ToggleAllSelectionCommand}" />
                    <Button Classes="toolbarAction" Content="{Binding ReloadModsButtonText}" Command="{Binding ReloadModsCommand}" IsEnabled="{Binding IsLoadingMods, Converter={x:Static BoolConverters.Not}}" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Classes="hintCard" Padding="14,12">
                <StackPanel Spacing="10">
                  <TextBlock Text="{Binding ModSearchTitleText}" Classes="sectionTitle" />
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchKeyword}"
                             Watermark="{Binding ModSearchWatermarkText}"
                             Height="36"
                             VerticalContentAlignment="Center"
                             Padding="10,0" />
                    <Button Grid.Column="1"
                            Content="{Binding SearchClearText}"
                            Command="{Binding ClearSearchKeywordCommand}"
                            MinWidth="68" />
                    <Button Grid.Column="2"
                            Content="{Binding SearchAdvancedText}"
                            Command="{Binding ShowAdvancedSearchHelpCommand}"
                            MinWidth="92" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="hintCard" Padding="14,12" IsVisible="{Binding IsModsTab}">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding TagFilterTitleText}" Classes="sectionTitle" />
                    <Button Grid.Column="1"
                            Content="{Binding TagPanelToggleText}"
                            Command="{Binding ToggleTagPanelExpandedCommand}" />
                  </Grid>

                  <StackPanel Spacing="10" IsVisible="{Binding IsTagPanelExpanded}">

                    <Grid ColumnDefinitions="*,Auto">
                      <ComboBox Grid.Column="0" ItemsSource="{Binding TagFilters}" SelectedItem="{Binding SelectedTagFilter}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:ModTagFilterOption">
                            <TextBlock Text="{Binding DisplayText}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>

                      <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <CheckBox Content="{Binding TagFolderText}" IsChecked="{Binding ShowFolderTags}" Margin="0,0,8,0" />
                        <CheckBox Content="{Binding TagPrefixText}" IsChecked="{Binding ShowPrefixTags}" Margin="0,0,8,0" />
                        <CheckBox Content="{Binding TagCustomText}" IsChecked="{Binding ShowCustomTags}" />
                      </WrapPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                      <TextBox Grid.Column="0"
                               Text="{Binding TagSearchKeyword}"
                               Watermark="{Binding TagPlaceholderText}"
                               Height="34"
                               VerticalContentAlignment="Center" />
                      <Button Grid.Column="1" Content="{Binding TagAddText}" Command="{Binding AddCustomTagCommand}" MinWidth="70" Height="34" Margin="8,0,0,0" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding TagPanelItems}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModTagPanelItem">
                          <ToggleButton IsChecked="{Binding IsSelected}"
                                        PointerPressed="OnTagChipPointerPressed"
                                        Background="{DynamicResource CardHighlightBg}"
                                        BorderBrush="{DynamicResource PanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="999"
                                        Padding="10,4"
                                        Margin="0,0,8,8">
                            <ToggleButton.ContextMenu>
                              <ContextMenu>
                                <MenuItem Header="{Binding DataContext.TagRenameText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          Tag="{Binding .}"
                                          Click="OnCustomTagRenameClicked" />
                                <MenuItem Header="{Binding DataContext.TagDeleteText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          Tag="{Binding .}"
                                          Click="OnCustomTagDeleteClicked" />
                              </ContextMenu>
                            </ToggleButton.ContextMenu>
                            <TextBlock Text="{Binding DisplayText}" FontSize="12" />
                          </ToggleButton>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <WrapPanel>
                      <Button Content="{Binding TagSearchText}"
                              Command="{Binding ApplySelectedTagsToSearchCommand}"
                              IsEnabled="{Binding CanApplyTagSelectionToSearch}"
                              Margin="0,0,8,8" />
                      <Button Content="{Binding TagClearSelectedText}"
                              Command="{Binding ClearSelectedTagsCommand}"
                              Margin="0,0,0,8" />
                    </WrapPanel>

                    <TextBlock Text="{Binding TagHintText}"
                               FontSize="12"
                               Opacity="0.7"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{Binding InlineTagHint}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="hintCard" Padding="14,12" IsVisible="{Binding ShowModConflictResult}">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding ConflictTitleText}" Classes="sectionTitle" />
                    <Button Grid.Column="1"
                            Content="{Binding ConflictClearText}"
                            Command="{Binding ClearModConflictsCommand}"
                            Padding="10,4" />
                  </Grid>
                  <TextBlock Text="{Binding ModConflictSummary}"
                             FontSize="12"
                             Opacity="0.78"
                             TextWrapping="Wrap" />
                  <ScrollViewer MaxHeight="220"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled"
                                IsVisible="{Binding HasModConflicts}">
                    <ItemsControl ItemsSource="{Binding ModConflicts}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource CardHighlightBg}"
                                  BorderBrush="{DynamicResource PanelBorderBrush}"
                                  BorderThickness="1"
                                  CornerRadius="6"
                                  Padding="10,7"
                                  Margin="0,0,0,6">
                            <TextBlock Text="{Binding DisplayText}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Border>

              <Border Classes="hintCard" Padding="14,12" IsVisible="{Binding HasRunningModTask}">
                <StackPanel Spacing="10">
                  <TextBlock Text="{Binding TaskProgressTitleText}" Classes="sectionTitle" />

                  <StackPanel IsVisible="{Binding IsCheckingModUpdates}" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/RefreshCw.png" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding UpdateCheckTitleText}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding CurrentUpdateProcessingModName}" FontSize="13" Opacity="0.78" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateCheckProgressText}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                  </StackPanel>

                  <StackPanel IsVisible="{Binding IsCheckingLocalization}" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/RefreshCw.png" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding LocalizationCheckTitleText}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding CurrentLocalizationProcessingModName}" FontSize="13" Opacity="0.78" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="{Binding LocalizationCheckProgressText}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="hintCard" Padding="14,12" IsVisible="{Binding IsLoadingMods}">
                <StackPanel Spacing="8">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/RefreshCw.png" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LoadingModsTitleText}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                  </StackPanel>
                  <ProgressBar IsIndeterminate="True" Height="4" />
                  <TextBlock Text="{Binding Status}" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Classes="hintCard" IsVisible="{Binding ShowEmptyModsHint}">
                <TextBlock Text="{Binding CurrentEmptyHintText}" TextWrapping="Wrap" />
              </Border>

              <Border Classes="hintCard" IsVisible="{Binding HasMods}" Padding="0">
                <StackPanel>
                  <Border Padding="14,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MinWidth="24">
                        <CheckBox IsChecked="{Binding IsCurrentPageAllSelected}"
                                  Command="{Binding ToggleCurrentPageSelectionCommand}"
                                  IsEnabled="{Binding CanToggleCurrentPageSelection}" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding TableHeaderModsText}" FontSize="13" FontWeight="SemiBold" Opacity="0.75" VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsModsTab}" />
                      <TextBlock Grid.Column="1" Text="{Binding TableHeaderBackupModsText}" FontSize="13" FontWeight="SemiBold" Opacity="0.75" VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" IsVisible="{Binding IsBackupTab}" />
                      <TextBlock Grid.Column="2" Text="{Binding TableHeaderStatusText}" FontSize="13" FontWeight="SemiBold" Opacity="0.75" VerticalAlignment="Center" IsVisible="{Binding IsModsTab}" />
                      <TextBlock Grid.Column="2" Text="{Binding TableHeaderBackupTimeText}" FontSize="13" FontWeight="SemiBold" Opacity="0.75" VerticalAlignment="Center" IsVisible="{Binding IsBackupTab}" />
                    </Grid>
                  </Border>

                  <ListBox ItemsSource="{Binding FilteredMods}"
                           Classes="modList"
                           SelectedItem="{Binding SelectedMod}"
                           SelectionMode="Single,Toggle"
                           Margin="0"
                           Background="Transparent"
                           BorderThickness="0"
                           MaxHeight="520"
                           ScrollViewer.VerticalScrollBarVisibility="Auto"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <!-- 显式虚拟化：外层页面 ScrollViewer 会给出无限高度，必须给列表一个有限高度
                         （MaxHeight）并让其自身滚动，VirtualizingStackPanel 才会按视口回收条目。 -->
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ModManageItem">
                        <StackPanel>
                        <Border Classes="modRow" CornerRadius="8" Padding="12,10" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                              <TextBlock TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                <Run Text="{Binding DirectoryName}" FontSize="14" FontWeight="SemiBold" />
                                <Run Text=" | " FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Run Text="{Binding DisplayName}" FontSize="13" />
                                <Run Text="{Binding UpdateTagText}" FontSize="13" Foreground="{Binding UpdateTagColor}" />
                                <Run Text=" | " FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Run Text="{Binding Version}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Run Text=" | " FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Run Text="{Binding Author}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                              </TextBlock>
                              <TextBlock Margin="0,4,0,0" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                <Run Text="{Binding DataContext.ModDescriptionLabelText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <Run Text="{Binding Description}" />
                              </TextBlock>
                              <TextBlock Margin="0,4,0,0" Opacity="0.62" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" IsVisible="{Binding HasBackupSummary}">
                                <Run Text="{Binding BackupSummaryText}" />
                              </TextBlock>
                              <StackPanel Orientation="Horizontal" Margin="0,4,0,0" IsVisible="{Binding HasChildren}">
                                <TextBlock Text="{Binding ChildModsSummaryText}" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                                <Button Content="{Binding GroupToggleText}"
                                        Command="{Binding DataContext.ToggleModGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding .}"
                                        Margin="8,0,0,0"
                                        Padding="8,2"
                                        MinWidth="52"
                                        FontSize="11" />
                              </StackPanel>
                              <StackPanel Margin="0,4,0,0" Orientation="Horizontal" IsVisible="{Binding HasDisplayDependencies}">
                                <TextBlock Text="{Binding DataContext.DependencyPrefixText, RelativeSource={RelativeSource AncestorType=UserControl}}" Opacity="0.64" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Top" />
                                <ItemsControl ItemsSource="{Binding DisplayDependencies}" MaxWidth="360">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                      <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <Button Command="{Binding DataContext.ClickDependencySearchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding .}"
                                              Margin="0,0,6,4"
                                              Padding="0"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Cursor="Hand"
                                              ToolTip.Tip="{Binding UniqueId}">
                                        <TextBlock FontSize="11">
                                          <Run Text="{Binding StatusPrefix}" Foreground="{Binding StatusPrefixColor}" />
                                          <Run Text="{Binding StatusSuffix}" Foreground="{DynamicResource AccentBrush}" />
                                          <Run Text="{Binding DisplayText}" Foreground="{DynamicResource AccentBrush}" />
                                        </TextBlock>
                                      </Button>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                              <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding DisplayTags}" IsVisible="{Binding HasAnyTag}">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <WrapPanel />
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Button Command="{Binding DataContext.ClickTagSearchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding .}"
                                            Background="{DynamicResource CardHighlightBg}"
                                            BorderBrush="{DynamicResource PanelBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="999"
                                            Padding="8,2"
                                            Margin="0,0,6,4"
                                            FontSize="11">
                                      <TextBlock Text="{Binding .}" />
                                    </Button>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>

                            <Grid Grid.Column="2" MinWidth="260" VerticalAlignment="Center">
                              <StackPanel Classes="rowMeta" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding PrimaryStateText}" FontSize="12" FontWeight="SemiBold" Opacity="0.75" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding SecondaryStateText}" FontSize="12" Opacity="0.5" HorizontalAlignment="Right" />
                              </StackPanel>

                              <StackPanel Classes="rowHoverActions" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="6">
                                <WrapPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                  <Button Classes="rowAction" IsVisible="{Binding HasLocalization}" Command="{Binding DataContext.ToggleModLocalizationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}" ToolTip.Tip="{Binding DataContext.ToggleLangTipText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <TextBlock Text="{Binding LocalizationToggleButtonText}" FontSize="11" FontWeight="SemiBold" />
                                  </Button>
                                  <Button Classes="rowAction" Command="{Binding DataContext.ShowLocalItemDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}" ToolTip.Tip="{Binding DataContext.ViewLocalDetailTipText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/FileText.png" Width="18" Height="18" Stretch="Uniform" />
                                  </Button>
                                  <Button Classes="rowAction" IsVisible="{Binding IsNormalItem}" Command="{Binding DataContext.ShowOnlineItemDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}" ToolTip.Tip="{Binding DataContext.ViewOnlineDetailTipText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/Globe.png" Width="18" Height="18" Stretch="Uniform" />
                                  </Button>
                                  <Button Classes="rowAction" Command="{Binding DataContext.OpenItemFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}" ToolTip.Tip="{Binding DataContext.OpenItemFolderTipText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/FolderOpen.png" Width="18" Height="18" Stretch="Uniform" />
                                  </Button>
                                </WrapPanel>
                                <WrapPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                  <Button Classes="rowAction" IsVisible="{Binding IsNormalItem}" Command="{Binding DataContext.CheckItemUpdateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}" ToolTip.Tip="{Binding DataContext.ItemCheckUpdateTipText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/RefreshCw.png" Width="18" Height="18" Stretch="Uniform" />
                                  </Button>
                                  <Button Classes="rowAction" IsVisible="{Binding IsNormalItem}" Command="{Binding DataContext.ToggleItemEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}" ToolTip.Tip="{Binding DataContext.ItemToggleTipText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/Power.png" Width="18" Height="18" Stretch="Uniform" />
                                  </Button>
                                  <Button Classes="rowAction" IsVisible="{Binding IsNormalItem}" Command="{Binding DataContext.BackupItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}" ToolTip.Tip="{Binding DataContext.ItemBackupTipText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/HardDrive.png" Width="18" Height="18" Stretch="Uniform" />
                                  </Button>
                                  <Button Classes="rowAction" IsVisible="{Binding IsBackupItem}" Command="{Binding DataContext.RestoreItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}" ToolTip.Tip="{Binding DataContext.ItemRestoreTipText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/RotateCcw.png" Width="18" Height="18" Stretch="Uniform" />
                                  </Button>
                                  <Button Classes="rowAction" Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}" ToolTip.Tip="{Binding DataContext.ItemDeleteTipText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/Trash2.png" Width="18" Height="18" Stretch="Uniform" />
                                  </Button>
                                </WrapPanel>
                              </StackPanel>
                            </Grid>
                          </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding ChildMods}"
                                      IsVisible="{Binding IsGroupExpanded}"
                                      Margin="40,0,0,8">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModManageItem">
                              <Border Classes="modRow" CornerRadius="8" Padding="12,8" Margin="0,4,0,0"
                                      Background="{DynamicResource CardHighlightBg}"
                                      BorderBrush="{DynamicResource PanelBorderBrush}"
                                      BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                  <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,12,0" />
                                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                      <Run Text="{Binding DirectoryName}" FontSize="13" FontWeight="SemiBold" />
                                      <Run Text=" | " FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                      <Run Text="{Binding DisplayName}" FontSize="12" />
                                      <Run Text="{Binding DataContext.ChildSuffixText, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description}" Margin="0,3,0,0" FontSize="11" Opacity="0.65"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <ItemsControl Margin="0,3,0,0" ItemsSource="{Binding DisplayTags}" IsVisible="{Binding HasAnyTag}">
                                      <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                          <WrapPanel />
                                        </ItemsPanelTemplate>
                                      </ItemsControl.ItemsPanel>
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                          <TextBlock Text="{Binding .}" FontSize="10" Opacity="0.7" Margin="0,0,6,0" />
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>
                                  <WrapPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button Classes="rowAction" IsVisible="{Binding HasLocalization}" Command="{Binding DataContext.ToggleModLocalizationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}" ToolTip.Tip="{Binding DataContext.ToggleLangTipText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                      <TextBlock Text="{Binding LocalizationToggleButtonText}" FontSize="10" FontWeight="SemiBold" />
                                    </Button>
                                    <Button Classes="rowAction" Command="{Binding DataContext.ShowLocalItemDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}" ToolTip.Tip="{Binding DataContext.ViewLocalDetailTipText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                      <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/FileText.png" Width="16" Height="16" Stretch="Uniform" />
                                    </Button>
                                    <Button Classes="rowAction" Command="{Binding DataContext.OpenItemFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}" ToolTip.Tip="{Binding DataContext.OpenItemFolderTipText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                      <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/FolderOpen.png" Width="16" Height="16" Stretch="Uniform" />
                                    </Button>
                                    <Button Classes="rowAction" Command="{Binding DataContext.ToggleItemEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}" ToolTip.Tip="{Binding DataContext.ItemToggleTipText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                      <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/Power.png" Width="16" Height="16" Stretch="Uniform" />
                                    </Button>
                                    <Button Classes="rowAction" Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding .}" ToolTip.Tip="{Binding DataContext.ItemDeleteTipText, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                      <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/Trash2.png" Width="16" Height="16" Stretch="Uniform" />
                                    </Button>
                                  </WrapPanel>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>

                  <Border Padding="14,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                      <TextBlock Text="{Binding TotalDisplay}" VerticalAlignment="Center" Opacity="0.75" />

                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <Button Content="{Binding PrevPageText}"
                          Command="{Binding PreviousPageCommand}"
                          IsEnabled="{Binding HasPreviousPage}"
                          MinWidth="70"
                          Padding="12,0"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center" />

                        <ItemsControl ItemsSource="{Binding PageNumbers}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                    <Button Classes="paginationButton"
                                      Content="{Binding .}"
                                      Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding .}"
                                      Margin="2,0" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Content="{Binding NextPageText}"
                          Command="{Binding NextPageCommand}"
                          IsEnabled="{Binding HasNextPage}"
                          MinWidth="70"
                          Padding="12,0"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsSettingsSection}" Spacing="10">
            <Border Classes="hintCard" Padding="14,12">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/Info.png" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SettingsHintText}"
                           FontSize="13"
                           Opacity="0.84"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
              </StackPanel>
            </Border>

            <Border Classes="hintCard" Padding="16,12">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding LaunchOptionsTitleText}" Classes="sectionTitle" />

                <TextBlock Text="{Binding WindowTitleLabelText}" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Text="{Binding GameWindowTitle}" Watermark="{Binding WindowTitleWatermarkText}" />
                  <Button Grid.Column="1"
                          Content="?"
                          Command="{Binding ShowWindowTitleHelpCommand}"
                          Width="32"
                          Height="32"
                          Padding="0"
                          FontSize="16"
                          FontWeight="Bold"
                          Margin="8,0,0,0"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          ToolTip.Tip="{Binding WindowTitleHelpTipText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </Grid>

                <TextBlock Text="{Binding LaunchArgsLabelText}" FontWeight="SemiBold" />
                <TextBox Text="{Binding InstanceCustomLaunchArguments}"
                         Height="68"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Watermark="{Binding LaunchArgsWatermarkText}" />

                <WrapPanel>
                  <Button Content="{Binding ResetDefaultText}" Command="{Binding ResetStartupOptionsCommand}" Margin="0,0,8,8" />
                  <Button Content="{Binding SaveInstanceSettingsButtonText}" Command="{Binding SaveInstanceSettingsCommand}" Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Classes="hintCard" Padding="16,12">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding SteamOverrideTitleText}" Classes="sectionTitle" />
                <TextBlock Text="{Binding SteamOverrideDescText}"
                           FontSize="12"
                           Opacity="0.74"
                           TextWrapping="Wrap" />

                <TextBlock Text="{Binding DefaultCommandText}" FontWeight="SemiBold" />
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Background="{DynamicResource CardBrush}">
                  <TextBlock Text="{Binding DefaultSteamLaunchOptions}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                </Border>

                <CheckBox Content="{Binding OverrideCheckboxText}" IsChecked="{Binding OverrideSteamLaunchOptions}" />

                <TextBlock Text="{Binding EditArgsText}" FontWeight="SemiBold" />
                <TextBox Text="{Binding SteamLaunchOptions}"
                         AcceptsReturn="True"
                         Height="72"
                         TextWrapping="Wrap"
                         Watermark="{Binding SteamArgsWatermarkText}" />

                <TextBlock Text="{Binding PreviewArgsText}" FontWeight="SemiBold" />
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Background="{DynamicResource CardBrush}">
                  <TextBlock Text="{Binding SteamLaunchOptionsPreview}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                </Border>

                <WrapPanel>
                  <Button Content="{Binding WriteSteamText}" Command="{Binding WriteSteamLaunchOptionsCommand}" Margin="0,0,8,8" />
                  <Button Content="{Binding SaveInstanceSettingsButtonText}" Command="{Binding SaveInstanceSettingsCommand}" Margin="0,0,8,8" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <Border Classes="hintCard" IsVisible="{Binding IsModpackSection}" Padding="14,12">
            <StackPanel Spacing="12">
              <!-- 顶部分段切换栏：导入整合包 / 导出整合包 -->
              <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardHighlightBg}">
                <Grid ColumnDefinitions="*,1,*">
                  <Button Grid.Column="0"
                          Classes="segmentMain"
                          Classes.selected="{Binding IsModpackImportTab}"
                          Command="{Binding SwitchModpackImportTabCommand}"
                          Content="{Binding ModpackImportTabText}" />
                  <Border Grid.Column="1" Background="{DynamicResource PanelBorderBrush}" />
                  <Button Grid.Column="2"
                          Classes="segmentMain"
                          Classes.selected="{Binding IsModpackExportTab}"
                          Command="{Binding SwitchModpackExportTabCommand}"
                          Content="{Binding ModpackExportTabText}" />
                </Grid>
              </Border>

              <!-- 【导入整合包】分栏视图 -->
              <StackPanel Spacing="12" IsVisible="{Binding IsModpackImportTab}">
                <!-- 本地文件导入主卡片 -->
                <Border Classes="hintCard" Padding="16,14">
                  <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,*">
                      <Border Width="44"
                              Height="44"
                              CornerRadius="8"
                              Background="{DynamicResource CardHighlightBg}"
                              BorderBrush="{DynamicResource PanelBorderBrush}"
                              BorderThickness="1"
                              Margin="0,0,12,0">
                        <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/Package.png"
                               Width="26" Height="26"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ModpackImportTitleText}" Classes="sectionTitle" />
                        <TextBlock Text="{Binding ModpackImportDescText}"
                                   FontSize="12"
                                   Opacity="0.75"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>

                    <Button Classes="pathAction primary"
                            Content="{Binding ModpackPickButtonText}"
                            Command="{Binding PickAndImportModpackCommand}"
                            Height="40"
                            Margin="0,6,0,0" />

                    <Border Background="{DynamicResource CardHighlightBg}"
                            BorderBrush="{DynamicResource PanelBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10">
                      <Grid ColumnDefinitions="Auto,*">
                        <Image Source="avares://SVL.Avalonia/Assets/Icons/Generated/Cropped/Upload.png"
                               Width="18" Height="18"
                               Stretch="Uniform"
                               VerticalAlignment="Center"
                               Opacity="0.75"
                               Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ModpackDropHintText}"
                                   FontSize="12"
                                   Opacity="0.75"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>

                <!-- 在线搜索整合包次级卡片 -->
                <Border Classes="hintCard" Padding="16,14">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="{Binding ModpackOnlineTitleText}" Classes="sectionTitle" />
                      <TextBlock Text="{Binding ModpackOnlineDescText}"
                                 FontSize="12"
                                 Opacity="0.75"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Classes="toolbarAction"
                            Content="{Binding ModpackOnlineButtonText}"
                            Command="{Binding NavigateToOnlineModpackSearchCommand}"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0" />
                  </Grid>
                </Border>
              </StackPanel>

              <!-- 【导出整合包】分栏视图 -->
              <StackPanel Spacing="10" IsVisible="{Binding IsModpackExportTab}">
                <TextBlock Text="{Binding ExportSectionTitleText}" Classes="sectionTitle" />

                <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ExportModpackNameLabelText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                  <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ModpackName}" Margin="0,0,0,8" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ExportVersionLabelText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ModpackVersion}" Margin="0,0,0,8" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding ExportAuthorLabelText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                  <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ModpackAuthor}" />
                </Grid>

                <TextBlock Text="{Binding ExportContentTitleText}" FontWeight="SemiBold" />
                <StackPanel Spacing="6">
                  <CheckBox Content="{Binding IncludeModsText}"
                            IsChecked="{Binding IncludeMods}" />
                  <CheckBox Content="{Binding IncludeModFilesText}"
                            IsChecked="{Binding IncludeModFiles}"
                            IsEnabled="{Binding IncludeMods}"
                            Margin="24,0,0,0" />
                  <CheckBox Content="{Binding IncludeSettingsText}"
                            IsChecked="{Binding IncludeModSettings}" />
                  <CheckBox Content="{Binding IncludeLauncherText}"
                            IsChecked="{Binding IncludeSvlLauncher}" />
                </StackPanel>

                <Border BorderBrush="{DynamicResource PanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8"
                        IsVisible="{Binding ShowExportModList}">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                      <Button Grid.Column="0"
                              Content="{Binding ExportSelectAllText}"
                              Command="{Binding ToggleSelectAllExportModsCommand}"
                              Padding="8,4"
                              Margin="0,0,8,0" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding ExportProgressText}"
                                 VerticalAlignment="Center"
                                 Opacity="0.82" />
                      <TextBlock Grid.Column="2"
                                 Text="{Binding ExportSourcePriorityHintText}"
                                 FontSize="11"
                                 Opacity="0.68"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
                      <ItemsControl ItemsSource="{Binding ExportModItems}" MaxHeight="260">
                        <ItemsControl.Template>
                          <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                              <ItemsPresenter />
                            </ScrollViewer>
                          </ControlTemplate>
                        </ItemsControl.Template>
                        <!-- 高度已由 MaxHeight=260 限定，显式虚拟化避免大量 Mod 时一次性生成全部条目。 -->
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid ColumnDefinitions="30,*,110" Margin="2,2,2,4">
                              <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                              <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                <TextBlock FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis">
                                  <Run Text="{Binding Version}" />
                                  <Run Text=" · " />
                                  <Run Text="{Binding Author}" />
                                </TextBlock>
                              </StackPanel>
                              <TextBlock Grid.Column="2"
                                         Text="{Binding SourceDescription}"
                                         FontSize="11"
                                         Opacity="0.78"
                                         VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </StackPanel>
                </Border>

                <TextBlock Text="{Binding ExportStrategyText}"
                           Opacity="0.75"
                           TextWrapping="Wrap" />

                <ProgressBar Minimum="0"
                             Maximum="100"
                             Value="{Binding ExportProgress}"
                             Height="6"
                             IsVisible="{Binding IsExporting}" />

                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding ExportStatusMessage}" Opacity="0.75" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <Button Grid.Column="1" Content="{Binding SaveConfigText}" Command="{Binding SaveExportConfigCommand}" Margin="8,0,0,0" />
                  <Button Grid.Column="2" Content="{Binding LoadConfigText}" Command="{Binding LoadExportConfigCommand}" Margin="8,0,0,0" />
                  <Button Grid.Column="3"
                          Content="{Binding ExportCurrentModsButtonText}"
                          Command="{Binding ExportCurrentModsCommand}"
                          Margin="8,0,0,0"
                          IsEnabled="{Binding CanStartExport}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{Binding OpenExportFolderButtonText}" Command="{Binding OpenExportFolderCommand}" />
                  <TextBlock Text="{Binding ExportHint}" Opacity="0.75" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="1"
              IsVisible="{Binding ShowSelectionActionsBar}"
              Margin="0,10,0,0"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource PanelBorderBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="12,10"
              Opacity="0.98">
        <StackPanel Spacing="8">
          <StackPanel IsVisible="{Binding IsModsTab}" Spacing="8">
            <TextBlock Text="{Binding BatchSelectedModsDisplay}"
                       FontWeight="SemiBold"
                       FontSize="13" />
            <TextBlock Text="{Binding BatchHintModsText}"
                       Opacity="0.74"
                       FontSize="12" />
            <WrapPanel>
              <Button Content="{Binding BatchBackupSelectedText}" Command="{Binding BackupSelectedModsCommand}" Margin="0,0,8,8" />
              <Button Content="{Binding BatchEnableSelectedText}" Command="{Binding EnableSelectedModsCommand}" Margin="0,0,8,8" />
              <Button Content="{Binding BatchDisableSelectedText}" Command="{Binding DisableSelectedModsCommand}" Margin="0,0,8,8" />
              <Button Content="{Binding BatchDeleteSelectedText}" Command="{Binding DeleteSelectedModsCommand}" Margin="0,0,8,8" />
                    <Button Content="{Binding BatchAddToNewTagText}" Command="{Binding AddSelectedModsToNewTagCommand}" Margin="0,0,8,8" />
              <Button Content="{Binding TagBatchActionText}"
                      Command="{Binding ApplyTagBatchActionCommand}"
                      IsVisible="{Binding ShowTagBatchAction}"
                      Margin="0,0,8,8" />
              <Button Content="{Binding BatchCancelSelectionText}" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,8" />
            </WrapPanel>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsBackupTab}" Spacing="8">
            <TextBlock Text="{Binding BatchSelectedBackupsDisplay}"
                       FontWeight="SemiBold"
                       FontSize="13" />
            <TextBlock Text="{Binding BatchHintBackupsText}"
                       Opacity="0.74"
                       FontSize="12" />
            <WrapPanel>
              <Button Content="{Binding BatchRestoreSelectedText}" Command="{Binding RestoreSelectedBackupsCommand}" Margin="0,0,8,8" />
              <Button Content="{Binding BatchDeleteSelectedBackupsText}" Command="{Binding DeleteSelectedBackupsCommand}" Margin="0,0,8,8" />
              <Button Content="{Binding BatchCancelSelectionText}" Command="{Binding ClearSelectionCommand}" Margin="0,0,8,8" />
            </WrapPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>

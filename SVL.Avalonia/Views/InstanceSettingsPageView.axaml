<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SVL.Avalonia.ViewModels"
             x:Class="SVL.Avalonia.Views.InstanceSettingsPageView"
             x:DataType="vm:InstanceSettingsPageViewModel">
  <Border Classes="panel">
    <StackPanel Spacing="8">
      <TextBlock Text="{Binding Title}" Classes="heroTitle" />
      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
      <Separator />
      <TextBlock Text="实例名称" />
      <TextBox Text="{Binding InstanceName}" />
      <TextBlock Text="游戏窗口标题" />
      <TextBox Text="{Binding WindowTitle}" Watermark="&lt;default&gt; 或自定义标题" />
      <TextBlock Text="自定义启动参数" />
      <TextBox Text="{Binding CustomArguments}" Watermark="可选，例如 --skip-launcher" />
      <CheckBox Content="启动时自动连接服务器" IsChecked="{Binding AutoConnectServer}" />
      <TextBlock Text="服务器地址" />
      <TextBox Text="{Binding ServerAddress}" Watermark="例如 127.0.0.1:24642" />
      <TextBlock Text="Steam 邀请码" />
      <TextBox Text="{Binding SteamInviteCode}" Watermark="可选" />
      <CheckBox Content="收藏实例" IsChecked="{Binding IsFavoriteInstance}" />
      <CheckBox Content="覆写 Steam 启动参数" IsChecked="{Binding OverrideSteamLaunchOptions}" />
      <TextBlock Text="Steam 启动参数" />
      <TextBox Text="{Binding SteamLaunchOptions}" AcceptsReturn="True" Height="90" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Status}" Opacity="0.75" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="恢复默认" Command="{Binding ResetToDefaultCommand}" />
        <Button Content="保存实例设置" Command="{Binding SaveCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>

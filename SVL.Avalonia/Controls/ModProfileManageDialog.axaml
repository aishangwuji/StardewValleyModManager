<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:SVL.Avalonia.Models"
        x:Class="SVL.Avalonia.Controls.ModProfileManageDialog"
        x:Name="Root"
        Width="680"
        Height="540"
        WindowStartupLocation="CenterOwner"
        Title="Mod 整合包预设管理"
        CanResize="False"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Border Padding="18"
          Background="{DynamicResource CardBrush}"
          BorderBrush="{DynamicResource PanelBorderBrush}"
          BorderThickness="1"
          CornerRadius="10">
    <Grid RowDefinitions="Auto,*,Auto">
      <!-- 顶部标题与说明 -->
      <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,12">
        <TextBlock Text="📦 Mod 整合包 / 预设管理" FontSize="18" FontWeight="Bold" />
        <TextBlock Text="通过 SMAPI 原生 --mods-path 参数切换不同 Mod 组合，文件零移动，瞬时切换不同整合包体验。"
                   FontSize="12"
                   Opacity="0.75"
                   TextWrapping="Wrap" />
      </StackPanel>

      <!-- 中间列表与编辑区 -->
      <Grid Grid.Row="1" ColumnDefinitions="260,1,*" Margin="0,4,0,12">
        <!-- 左侧：预设列表 -->
        <Border Grid.Column="0" Classes="panel" Padding="8">
          <Grid RowDefinitions="*,Auto">
            <ListBox Grid.Row="0"
                     x:Name="ProfileListBox"
                     ItemsSource="{Binding Profiles, ElementName=Root}"
                     SelectedItem="{Binding SelectedProfile, ElementName=Root, Mode=TwoWay}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:ModProfileRecord">
                  <Grid ColumnDefinitions="*,Auto" Margin="4,2">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                        <Border IsVisible="{Binding IsDefault}"
                                Background="#2A80D0"
                                CornerRadius="4"
                                Padding="4,1">
                          <TextBlock Text="默认" FontSize="10" Foreground="White" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding ModsPath}"
                                 FontSize="11"
                                 Opacity="0.6"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding ModsPath}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Button Grid.Row="1"
                    Content="➕ 新建预设"
                    Click="NewProfile_Click"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,8,0,0" />
          </Grid>
        </Border>

        <!-- 分割线 -->
        <Border Grid.Column="1" Background="{DynamicResource PanelBorderBrush}" Margin="8,0" />

        <!-- 右侧：当前选中项详情 / 编辑 -->
        <ScrollViewer Grid.Column="2" Padding="4">
          <StackPanel Spacing="12">
            <TextBlock Text="预设详情与设置" FontSize="14" FontWeight="SemiBold" />

            <!-- 预设名称 -->
            <StackPanel Spacing="4">
              <TextBlock Text="预设名称:" FontSize="12" Opacity="0.8" />
              <TextBox x:Name="NameTextBox"
                       Text="{Binding EditingProfile.Name, ElementName=Root, Mode=TwoWay}"
                       Watermark="例如：SVE 大型扩展包 / 纯净小清新" />
            </StackPanel>

            <!-- Mods 路径 -->
            <StackPanel Spacing="4">
              <TextBlock Text="Mods 文件夹路径:" FontSize="12" Opacity="0.8" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         x:Name="ModsPathTextBox"
                         Text="{Binding EditingProfile.ModsPath, ElementName=Root, Mode=TwoWay}"
                         Watermark="留空则表示使用实例自带的默认 Mods 目录"
                         IsReadOnly="{Binding EditingProfile.IsDefault, ElementName=Root}" />
                <Button Grid.Column="1"
                        Content="浏览..."
                        Click="BrowseModsFolder_Click"
                        Margin="6,0,0,0"
                        IsEnabled="{Binding !EditingProfile.IsDefault, ElementName=Root}" />
              </Grid>
              <TextBlock Text="💡 提示：SMAPI 启动时将直接加载此目录下的所有 Mod。"
                         FontSize="11"
                         Opacity="0.65" />
            </StackPanel>

            <!-- 独立存档选项 -->
            <Border Classes="hintCard" Padding="10" Margin="0,4,0,0">
              <StackPanel Spacing="8">
                <CheckBox Content="为此整合包启用独立存档空间 (--save-path)"
                          IsChecked="{Binding EditingProfile.EnableCustomSavePath, ElementName=Root, Mode=TwoWay}"
                          IsEnabled="{Binding !EditingProfile.IsDefault, ElementName=Root}" />
                <TextBlock Text="若开启，此整合包将在专属目录下读取与保存存档，彻底杜绝手滑点错导致老存档物品损坏。"
                           FontSize="11"
                           Opacity="0.7"
                           TextWrapping="Wrap" />

                <StackPanel Spacing="4" IsVisible="{Binding EditingProfile.EnableCustomSavePath, ElementName=Root}">
                  <TextBlock Text="专属 Saves 文件夹路径:" FontSize="12" Opacity="0.8" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             x:Name="SavePathTextBox"
                             Text="{Binding EditingProfile.CustomSavePath, ElementName=Root, Mode=TwoWay}"
                             Watermark="留空将在 Mods 所在目录下自动创建 Saves 文件夹" />
                    <Button Grid.Column="1"
                            Content="浏览..."
                            Click="BrowseSaveFolder_Click"
                            Margin="6,0,0,0" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- 操作按钮 -->
            <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
              <Button Grid.Column="0"
                      Content="📂 打开 Mods 目录"
                      Click="OpenModsFolder_Click"
                      HorizontalAlignment="Left" />
              <Button Grid.Column="1"
                      Content="🗑️ 删除此预设"
                      Click="DeleteProfile_Click"
                      Foreground="#E53935"
                      IsEnabled="{Binding !EditingProfile.IsDefault, ElementName=Root}"
                      Margin="0,0,8,0" />
              <Button Grid.Column="2"
                      Content="💾 保存修改"
                      Click="SaveProfile_Click"
                      Classes="accent" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- 底部操作栏 -->
      <Border Grid.Row="2" Padding="0,10,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelBorderBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     x:Name="StatusMessageTextBlock"
                     Text="{Binding StatusMessage, ElementName=Root}"
                     VerticalAlignment="Center"
                     FontSize="12"
                     Foreground="{DynamicResource AccentBrush}" />
          <Button Grid.Column="1"
                  Content="关闭"
                  Click="Close_Click"
                  MinWidth="88"
                  HorizontalContentAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>

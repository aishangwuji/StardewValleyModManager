<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:SVL.Avalonia.Models"
        x:Class="SVL.Avalonia.Controls.ModProfileManageDialog"
        x:Name="Root"
        Width="780"
        Height="600"
        WindowStartupLocation="CenterOwner"
        Title="Mod 整合包预设管理"
        CanResize="False"
        Background="{DynamicResource WindowBackgroundBrush}">
  <Border Padding="22"
          Background="{DynamicResource CardBrush}"
          BorderBrush="{DynamicResource PanelBorderBrush}"
          BorderThickness="1"
          CornerRadius="12">
    <Grid RowDefinitions="Auto,*,Auto">
      <!-- 顶部标题与说明 -->
      <Border Grid.Row="0" Margin="0,0,0,16" Padding="14,12" Background="{DynamicResource HintBackgroundBrush}" CornerRadius="8">
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Grid.Column="0" Text="📦" FontSize="26" VerticalAlignment="Center" Margin="0,0,14,0" />
          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="Mod 整合包 / 预设管理" FontSize="16" FontWeight="Bold" />
            <TextBlock Text="通过 SMAPI 原生 --mods-path 与 --save-path 参数切换不同 Mod 组合，文件零移动，瞬时切换不同整合包体验。"
                       FontSize="12"
                       Opacity="0.75"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 中间列表与编辑区 -->
      <Grid Grid.Row="1" ColumnDefinitions="270,1,*" Margin="0,0,0,16">
        <!-- 左侧：预设列表 -->
        <Border Grid.Column="0" Classes="panel" Padding="10">
          <Grid RowDefinitions="*,Auto">
            <ListBox Grid.Row="0"
                     x:Name="ProfileListBox"
                     ItemsSource="{Binding Profiles, ElementName=Root}"
                     SelectedItem="{Binding SelectedProfile, ElementName=Root, Mode=TwoWay}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:ModProfileRecord">
                  <Grid ColumnDefinitions="*,Auto" Margin="4,4">
                    <StackPanel Grid.Column="0" Spacing="4">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <Border IsVisible="{Binding IsDefault}"
                                Background="#2A80D0"
                                CornerRadius="10"
                                Padding="6,1"
                                VerticalAlignment="Center">
                          <TextBlock Text="默认" FontSize="10" Foreground="White" />
                        </Border>
                        <Border IsVisible="{Binding EnableCustomSavePath}"
                                Background="#388E3C"
                                CornerRadius="10"
                                Padding="6,1"
                                VerticalAlignment="Center">
                          <TextBlock Text="独立存档" FontSize="10" Foreground="White" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding ModsPath}"
                                 FontSize="11"
                                 Opacity="0.6"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding ModsPath}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Button Grid.Row="1"
                    Content="➕ 新建预设"
                    Click="NewProfile_Click"
                    Classes="launchSecondary"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Height="36"
                    Margin="0,10,0,0" />
          </Grid>
        </Border>

        <!-- 分割线 -->
        <Border Grid.Column="1" Background="{DynamicResource PanelBorderBrush}" Margin="14,0" />

        <!-- 右侧：当前选中项详情 / 编辑 -->
        <ScrollViewer Grid.Column="2" Padding="2,0,6,0">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="预设参数配置" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock Text="{Binding EditingProfile.Name, ElementName=Root, StringFormat=当前: {0}}"
                         FontSize="12" Opacity="0.6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200" />
            </Grid>

            <!-- 预设名称 -->
            <StackPanel Spacing="6">
              <TextBlock Text="预设显示名称:" FontSize="12" FontWeight="Medium" Opacity="0.85" />
              <TextBox x:Name="NameTextBox"
                       Height="36"
                       VerticalContentAlignment="Center"
                       Text="{Binding EditingProfile.Name, ElementName=Root, Mode=TwoWay}"
                       Watermark="例如：SVE 大型扩展包 / 纯净小清新" />
            </StackPanel>

            <!-- Mods 路径 -->
            <StackPanel Spacing="6">
              <TextBlock Text="Mods 文件夹路径:" FontSize="12" FontWeight="Medium" Opacity="0.85" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0"
                         x:Name="ModsPathTextBox"
                         Height="36"
                         VerticalContentAlignment="Center"
                         Text="{Binding EditingProfile.ModsPath, ElementName=Root, Mode=TwoWay}"
                         Watermark="留空则表示使用实例自带的默认 Mods 目录"
                         IsReadOnly="{Binding EditingProfile.IsDefault, ElementName=Root}" />
                <Button Grid.Column="1"
                        Content="浏览..."
                        Click="BrowseModsFolder_Click"
                        Height="36"
                        Padding="14,0"
                        Margin="8,0,0,0"
                        IsEnabled="{Binding !EditingProfile.IsDefault, ElementName=Root}" />
              </Grid>
              <TextBlock Text="💡 提示：SMAPI 启动时将直接通过 --mods-path 加载此目录下的所有 Mod。"
                         FontSize="11"
                         Opacity="0.65"
                         TextWrapping="Wrap" />
            </StackPanel>

            <!-- 独立存档选项 -->
            <Border Classes="hintCard" Padding="14">
              <StackPanel Spacing="10">
                <CheckBox Content="为此预设启用独立存档空间 (--save-path)"
                          IsChecked="{Binding EditingProfile.EnableCustomSavePath, ElementName=Root, Mode=TwoWay}"
                          IsEnabled="{Binding !EditingProfile.IsDefault, ElementName=Root}"
                          FontWeight="Medium" />
                <TextBlock Text="若开启，此整合包将在专属目录下读取与保存存档，彻底杜绝多整合包混玩导致老存档物品损坏。"
                           FontSize="11"
                           Opacity="0.72"
                           TextWrapping="Wrap" />

                <StackPanel Spacing="6" Margin="0,4,0,0" IsVisible="{Binding EditingProfile.EnableCustomSavePath, ElementName=Root}">
                  <TextBlock Text="专属 Saves 文件夹路径:" FontSize="12" Opacity="0.85" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             x:Name="SavePathTextBox"
                             Height="36"
                             VerticalContentAlignment="Center"
                             Text="{Binding EditingProfile.CustomSavePath, ElementName=Root, Mode=TwoWay}"
                             Watermark="留空将在 Mods 所在目录下自动创建 Saves 文件夹" />
                    <Button Grid.Column="1"
                            Content="浏览..."
                            Click="BrowseSaveFolder_Click"
                            Height="36"
                            Padding="14,0"
                            Margin="8,0,0,0" />
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- 操作按钮 -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,4,0,0">
              <Button Grid.Column="0"
                      Content="📂 打开 Mods 目录"
                      Click="OpenModsFolder_Click"
                      Classes="launchSecondary"
                      Height="36"
                      Padding="12,0" />
              <Button Grid.Column="2"
                      Content="🗑️ 删除预设"
                      Click="DeleteProfile_Click"
                      Foreground="#E53935"
                      IsEnabled="{Binding !EditingProfile.IsDefault, ElementName=Root}"
                      Height="36"
                      Padding="12,0"
                      Margin="0,0,10,0" />
              <Button Grid.Column="3"
                      Content="💾 保存修改"
                      Click="SaveProfile_Click"
                      Classes="launchPrimary"
                      Height="36"
                      Padding="18,0" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- 底部操作栏 -->
      <Border Grid.Row="2" Padding="0,14,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource PanelBorderBrush}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     x:Name="StatusMessageTextBlock"
                     Text="{Binding StatusMessage, ElementName=Root}"
                     VerticalAlignment="Center"
                     FontSize="12"
                     Foreground="{DynamicResource AccentBrush}"
                     TextWrapping="Wrap" />
          <Button Grid.Column="1"
                  Content="完成并返回"
                  Click="Close_Click"
                  Classes="launchSecondary"
                  MinWidth="96"
                  Height="34"
                  HorizontalContentAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
